{
  "name": "mugen-fighting",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "frontend",
    "backend"
  ],
  "scripts": {
    "gen:assets": "tsx tools/gen-sprites.ts && tsx tools/gen-stages.ts",
    "dev": "npm run gen:assets && concurrently -k -n WEB,NET -c cyan,magenta \"npm -w @mugen/frontend run dev\" \"npm -w @mugen/backend run dev\"",
    "dev:frontend": "npm -w @mugen/frontend run dev",
    "dev:backend": "npm -w @mugen/backend run dev",
    "build": "npm run gen:assets && npm -w @mugen/frontend run typecheck && npm -w @mugen/frontend run build && npm -w @mugen/backend run build",
    "preview": "npm -w @mugen/frontend run preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:determinism": "tsx tools/verify-determinism.ts",
    "typecheck": "tsc -p tsconfig.base.json --noEmit"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
