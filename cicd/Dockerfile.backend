# Netplay relay: HTTP (GET /health, /api/*) + WebSocket lockstep relay on :8000.
# Build context is the repo root.
FROM node:22-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
COPY shared/package.json ./shared/package.json
COPY frontend/package.json ./frontend/package.json
COPY backend/package.json ./backend/package.json
RUN npm ci --no-audit --no-fund
COPY shared ./shared
COPY backend ./backend
# Bundle the backend + @mugen/shared into one file; keep 'ws' external.
RUN npx --yes esbuild backend/src/index.ts \
      --bundle --platform=node --format=esm --target=node22 \
      --external:ws --outfile=backend/dist/index.js

FROM node:22-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=8000
RUN npm init -y >/dev/null 2>&1 && npm pkg set type=module >/dev/null 2>&1 \
    && npm install --no-audit --no-fund --omit=dev ws@^8.18.0
COPY --from=build /app/backend/dist ./dist
EXPOSE 8000
CMD ["node", "dist/index.js"]
